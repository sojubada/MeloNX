<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TrollStore only. A normal signature cannot carry these.

	     dynamic-codesigning
	       JIT without a debugger: pages may flip RW -> RX. TVSystem.swift checks it
	       first, exactly like Common/JITChecker.swift on iOS.

	     platform-application, no-container, no-sandbox, skip-library-validation
	       The set Argo (sojubada/argo) runs with on tvOS 16.6. Lets the app use the
	       fixed data folder /var/mobile/Media/MeloNX that a file browser can fill.

	     increased-memory-limit, extended-virtual-addressing
	       The core reserves large guest address ranges (MeloNX README: both are
	       required on 4 GB devices).

	     private.memorystatus
	       memorystatus_control to raise our own jetsam limit (TVMemory), in place
	       of the iOS RamDonor AR extension that tvOS does not have. -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<key>dynamic-codesigning</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.private.memorystatus</key>
	<true/>
</dict>
</plist>
