<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TrollStore only.

	     NOT dynamic-codesigning: on A12+ with iOS/tvOS 15+ it (like
	     com.apple.private.cs.debugger and com.apple.private.skip-library-validation)
	     is banned and "apps signed with them will crash on launch" (TrollStore README).
	     JIT comes from TrollStore attaching a debugger instead ("Open with JIT" or
	     apple-magnifier://enable-jit), which sets CS_DEBUGGED - same as MeloNX on iPad.

	     get-task-allow
	       lets TrollStore attach to the process to turn JIT on.

	     increased-memory-limit, extended-virtual-addressing
	       the core reserves large guest address ranges.

	     private.memorystatus
	       memorystatus_control to raise our own jetsam limit (TVMemory).

	     private.security.no-sandbox
	       the tvOS sandbox denies an app its own Documents/ (device log: "app can
	       write: false", files there invisible). Without it MeloNX could not use
	       the upstream layout Documents/roms, Documents/system/prod.keys. Argo uses
	       it on the same Apple TV. The data container itself is kept. -->
	<key>get-task-allow</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.private.memorystatus</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
</dict>
</plist>
