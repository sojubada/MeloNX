<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS 판에서 제거한 키
	     · UIFileSharingEnabled        : tvOS에 iTunes 파일공유가 없다
	     · UISupportsDocumentBrowser   : tvOS에 문서 브라우저가 없다
	     · UIApplicationSceneManifest  : 외부 디스플레이 씬 역할이 무의미
	     · UIApplicationSupportsIndirectInputEvents / 방향 키
	     TrollStore 설치본은 샌드박스 밖을 직접 읽으므로 파일공유가 필요 없다.
	     ROM 반입은 Compat/TVFileBrowser.swift 가 담당한다. -->

	<key>CFBundleExecutable</key>
	<string>MeloNX</string>
	<key>CFBundleIdentifier</key>
	<string>com.stossy11.MeloNX</string>
	<key>CFBundleName</key>
	<string>MeloNX</string>
	<key>CFBundleDisplayName</key>
	<string>MeloNX</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- 게임 컨트롤러. 8BitDo 를 포함한 Extended Gamepad 프로파일 기기.
	     코드는 iOS 판과 동일하게 GameController + SDL3 양쪽 경로를 쓴다. -->
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>GCRequiresControllerUserInteraction</key>
	<true/>

	<!-- JIT 제공자 호출용 URL 스킴. TrollStore 설치본에서는
	     dynamic-codesigning 이 직접 붙으므로 실제로는 쓰이지 않는다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.stossy11.MeloNX</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>melonx</string>
			</array>
		</dict>
	</array>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Nintendo Switch Package</string>
			<key>UTTypeIdentifier</key>
			<string>com.nintendo.switch-package</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nsp</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Nintendo Switch Cartridge</string>
			<key>UTTypeIdentifier</key>
			<string>com.nintendo.switch-cartridge</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>xci</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
