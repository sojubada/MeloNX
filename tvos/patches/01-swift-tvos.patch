diff -ruN a/Compat/TVControls.swift b/Compat/TVControls.swift
--- a/Compat/TVControls.swift	1970-01-01 09:00:00.000000000 +0900
+++ b/Compat/TVControls.swift	2026-10-11 16:37:28.183583301 +0900
@@ -0,0 +1,94 @@
+//
+//  TVControls.swift
+//  MeloNX
+//
+//  tvOS에 없는 SwiftUI 컨트롤의 포커스 기반 대체물과,
+//  두 플랫폼에서 같은 호출부를 쓰게 해 주는 modifier.
+//
+//  이 파일은 양쪽 플랫폼에서 모두 컴파일된다 (#if 는 안쪽에만).
+//
+
+import SwiftUI
+
+// MARK: - 스와이프 액션 호환
+
+extension View {
+    /// iOS에서는 스와이프, tvOS에서는 컨텍스트 메뉴(선택 버튼 길게 누르기)로
+    /// 같은 메뉴를 노출한다. SwiftUI의 swipeActions 는 tvOS에서 쓸 수 없지만
+    /// contextMenu 는 tvOS 14+ 에서 동작한다.
+    @ViewBuilder
+    func rowActions<Content: View>(@ViewBuilder _ content: () -> Content) -> some View {
+        #if os(tvOS)
+        self.contextMenu(menuItems: content)
+        #else
+        self.swipeActions(edge: .trailing, content: content)
+        #endif
+    }
+}
+
+// MARK: - tvOS 슬라이더
+
+#if os(tvOS)
+
+/// tvOS에는 SwiftUI Slider 가 없다. 좌/우 입력으로 step 단위 조정하는
+/// 포커스 가능한 대체 컨트롤. 8BitDo D-pad와 Siri Remote 모두 동작한다.
+///
+/// 포커스를 받은 상태에서 좌/우를 누르면 값이 바뀐다. tvOS는 포커스된
+/// 뷰에 방향 입력을 먼저 전달하므로, onMoveCommand 로 받아 처리한다.
+struct TVSlider: View {
+    @Binding var value: Float
+    let range: ClosedRange<Float>
+    let step: Float
+
+    @FocusState private var focused: Bool
+
+    private var fraction: CGFloat {
+        let span = range.upperBound - range.lowerBound
+        guard span > 0 else { return 0 }
+        return CGFloat((value - range.lowerBound) / span)
+    }
+
+    var body: some View {
+        GeometryReader { geo in
+            ZStack(alignment: .leading) {
+                Capsule()
+                    .fill(Color.white.opacity(0.18))
+                    .frame(height: 10)
+                Capsule()
+                    .fill(focused ? Color.white : Color.white.opacity(0.55))
+                    .frame(width: max(10, geo.size.width * fraction), height: 10)
+                Circle()
+                    .fill(Color.white)
+                    .frame(width: focused ? 30 : 22, height: focused ? 30 : 22)
+                    .offset(x: max(0, geo.size.width * fraction - (focused ? 15 : 11)))
+                    .shadow(radius: focused ? 8 : 0)
+            }
+            .frame(height: 40)
+        }
+        .frame(height: 40)
+        .focusable(true)
+        .focused($focused)
+        .animation(.easeOut(duration: 0.12), value: value)
+        .animation(.easeOut(duration: 0.15), value: focused)
+        .onMoveCommand { direction in
+            switch direction {
+            case .left:  adjust(by: -step)
+            case .right: adjust(by: +step)
+            default:     break
+            }
+        }
+        // 포커스 중일 때만 재생/일시정지 버튼으로 양 끝으로 점프
+        .onPlayPauseCommand {
+            value = (value - range.lowerBound) < (range.upperBound - value)
+                ? range.upperBound : range.lowerBound
+        }
+    }
+
+    private func adjust(by delta: Float) {
+        let raw = value + delta
+        let snapped = step > 0 ? (raw / step).rounded() * step : raw
+        value = min(max(snapped, range.lowerBound), range.upperBound)
+    }
+}
+
+#endif
diff -ruN a/Compat/TVFileBrowser.swift b/Compat/TVFileBrowser.swift
--- a/Compat/TVFileBrowser.swift	1970-01-01 09:00:00.000000000 +0900
+++ b/Compat/TVFileBrowser.swift	2026-10-11 16:37:28.183222203 +0900
@@ -0,0 +1,277 @@
+//
+//  TVFileBrowser.swift
+//  MeloNX (tvOS)
+//
+//  tvOS에는 UIDocumentPickerViewController도 Files 앱도 없다.
+//  TrollStore 설치본은 샌드박스 밖을 읽을 수 있으므로, 직접 파일시스템을
+//  훑는 포커스 기반 브라우저로 문서 피커를 대체한다.
+//
+//  반환하는 URL은 평범한 file:// URL이고, ROMFolderManager.addFolder(url:)은
+//  URL만 받으므로 기존 스캔 파이프라인이 그대로 동작한다.
+//
+
+#if os(tvOS)
+
+import SwiftUI
+import UniformTypeIdentifiers
+
+// MARK: - 시작 위치
+
+enum TVBrowseRoot: Identifiable {
+    case appDocuments
+    case path(String, label: String)
+
+    var id: String { url?.path ?? label }
+
+    var label: String {
+        switch self {
+        case .appDocuments: return "앱 Documents"
+        case .path(_, let label): return label
+        }
+    }
+
+    var url: URL? {
+        switch self {
+        case .appDocuments:
+            return FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first
+        case .path(let p, _):
+            return FileManager.default.fileExists(atPath: p) ? URL(fileURLWithPath: p) : nil
+        }
+    }
+
+    /// TrollStore 환경에서 ROM을 둘 만한 곳들. 존재하지 않는 경로는
+    /// url 접근자에서 걸러지므로 목록에 나타나지 않는다.
+    static var all: [TVBrowseRoot] {
+        [
+            .appDocuments,
+            .path("/var/mobile/Media", label: "Media (/var/mobile/Media)"),
+            .path("/var/mobile/Documents", label: "Documents (/var/mobile)"),
+            .path("/var/mobile/Downloads", label: "Downloads"),
+            .path("/var/mobile", label: "mobile 홈"),
+            .path("/var/tmp", label: "tmp"),
+            .path("/", label: "루트 (/)"),
+        ]
+    }
+}
+
+// MARK: - 브라우저
+
+struct TVFileBrowser: View {
+
+    /// 빈 배열이면 전부 통과. `.folder`가 들어 있으면 폴더 선택 모드.
+    let allowedTypes: [UTType]
+    let allowMultiple: Bool
+    let onFinish: ([URL]) -> Void
+
+    @State private var stack: [URL] = []
+    @State private var entries: [Entry] = []
+    @State private var selected: Set<URL> = []
+    @State private var errorText: String?
+    @State private var showHidden = false
+
+    private struct Entry: Identifiable, Hashable {
+        let url: URL
+        let isDirectory: Bool
+        let sizeBytes: Int64
+        var id: URL { url }
+        var name: String { url.lastPathComponent }
+    }
+
+    private var folderMode: Bool { allowedTypes.contains(.folder) }
+    private var current: URL? { stack.last }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            titleBar
+            Divider().padding(.vertical, 10)
+
+            if let err = errorText {
+                Text(err)
+                    .foregroundStyle(.red)
+                    .padding(.vertical, 24)
+            }
+
+            ScrollView {
+                LazyVStack(alignment: .leading, spacing: 6) {
+                    if current == nil {
+                        ForEach(TVBrowseRoot.all) { root in
+                            if let url = root.url {
+                                rowButton(label: root.label, systemImage: "externaldrive") {
+                                    enter(url)
+                                }
+                            }
+                        }
+                    } else {
+                        rowButton(label: "⬆︎ 상위 폴더", systemImage: "arrow.up") { goUp() }
+                        ForEach(entries) { entry in
+                            entryRow(entry)
+                        }
+                        if entries.isEmpty {
+                            Text("비어 있음").foregroundStyle(.secondary).padding(.vertical, 20)
+                        }
+                    }
+                }
+                .padding(.vertical, 8)
+            }
+
+            Divider().padding(.vertical, 10)
+            footer
+        }
+        .padding(50)
+        .onAppear(perform: reload)
+    }
+
+    // MARK: 구성 요소
+
+    private var titleBar: some View {
+        VStack(alignment: .leading, spacing: 4) {
+            Text(folderMode ? "폴더 선택" : "파일 선택").font(.title2).bold()
+            Text(current?.path ?? "시작 위치를 고르세요")
+                .font(.system(.footnote, design: .monospaced))
+                .foregroundStyle(.secondary)
+                .lineLimit(1)
+                .truncationMode(.head)
+            if !allowedTypes.isEmpty && !folderMode {
+                Text("필터: " + allowedTypes.map { $0.preferredFilenameExtension ?? $0.identifier }
+                        .joined(separator: ", "))
+                    .font(.footnote)
+                    .foregroundStyle(.secondary)
+            }
+        }
+    }
+
+    private var footer: some View {
+        HStack(spacing: 24) {
+            if allowMultiple && !selected.isEmpty {
+                Text("\(selected.count)개 선택됨").foregroundStyle(.secondary)
+                Button("선택 완료") { finish(Array(selected)) }
+            }
+            if folderMode, let dir = current {
+                Button("이 폴더 사용") { finish([dir]) }
+            }
+            Button(showHidden ? "숨김 파일 숨기기" : "숨김 파일 보기") {
+                showHidden.toggle()
+                reload()
+            }
+            Spacer()
+            Button("취소") { finish([]) }
+        }
+    }
+
+    private func entryRow(_ entry: Entry) -> some View {
+        let isPicked = selected.contains(entry.url)
+        let icon = entry.isDirectory ? "folder"
+                 : (isPicked ? "checkmark.circle.fill" : "doc")
+        let detail = entry.isDirectory ? "" : byteLabel(entry.sizeBytes)
+
+        return rowButton(label: entry.name, systemImage: icon, detail: detail) {
+            if entry.isDirectory {
+                enter(entry.url)
+            } else if allowMultiple {
+                if isPicked { selected.remove(entry.url) } else { selected.insert(entry.url) }
+            } else {
+                finish([entry.url])
+            }
+        }
+    }
+
+    private func rowButton(label: String,
+                           systemImage: String,
+                           detail: String = "",
+                           action: @escaping () -> Void) -> some View {
+        Button(action: action) {
+            HStack(spacing: 18) {
+                Image(systemName: systemImage).frame(width: 40)
+                Text(label).lineLimit(1).truncationMode(.middle)
+                Spacer(minLength: 12)
+                if !detail.isEmpty {
+                    Text(detail)
+                        .font(.system(.footnote, design: .monospaced))
+                        .foregroundStyle(.secondary)
+                }
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+    }
+
+    // MARK: 동작
+
+    private func enter(_ url: URL) {
+        stack.append(url)
+        selected.removeAll()
+        reload()
+    }
+
+    private func goUp() {
+        _ = stack.popLast()
+        selected.removeAll()
+        reload()
+    }
+
+    private func reload() {
+        errorText = nil
+        guard let dir = current else { entries = []; return }
+
+        let fm = FileManager.default
+        do {
+            let urls = try fm.contentsOfDirectory(
+                at: dir,
+                includingPropertiesForKeys: [.isDirectoryKey, .fileSizeKey],
+                options: showHidden ? [] : [.skipsHiddenFiles]
+            )
+
+            entries = urls.compactMap { url -> Entry? in
+                let values = try? url.resourceValues(forKeys: [.isDirectoryKey, .fileSizeKey])
+                let isDir = values?.isDirectory ?? false
+                if !isDir && !passesFilter(url) { return nil }
+                return Entry(url: url,
+                             isDirectory: isDir,
+                             sizeBytes: Int64(values?.fileSize ?? 0))
+            }
+            .sorted {
+                if $0.isDirectory != $1.isDirectory { return $0.isDirectory }
+                return $0.name.localizedStandardCompare($1.name) == .orderedAscending
+            }
+        } catch {
+            entries = []
+            errorText = "읽을 수 없습니다: \(error.localizedDescription)"
+        }
+    }
+
+    /// UTType 해석에 의존하지 않고 확장자로도 통과시킨다.
+    /// nsp/xci 같은 커스텀 타입은 기기에 등록돼 있지 않으면 UTType 조회가 실패한다.
+    private func passesFilter(_ url: URL) -> Bool {
+        if allowedTypes.isEmpty { return true }
+        if allowedTypes.contains(.item) || allowedTypes.contains(.data) { return true }
+
+        let ext = url.pathExtension.lowercased()
+        for type in allowedTypes {
+            if let preferred = type.preferredFilenameExtension?.lowercased(), preferred == ext {
+                return true
+            }
+            for tag in type.tags[.filenameExtension] ?? [] where tag.lowercased() == ext {
+                return true
+            }
+        }
+        // 확장자로 못 맞추면 시스템 타입 추론을 한 번 더 시도
+        if let resolved = UTType(filenameExtension: ext) {
+            return allowedTypes.contains { resolved.conforms(to: $0) }
+        }
+        return false
+    }
+
+    private func finish(_ urls: [URL]) {
+        onFinish(urls)
+    }
+
+    private func byteLabel(_ bytes: Int64) -> String {
+        guard bytes > 0 else { return "" }
+        let units = ["B", "KB", "MB", "GB", "TB"]
+        var value = Double(bytes)
+        var idx = 0
+        while value >= 1024 && idx < units.count - 1 { value /= 1024; idx += 1 }
+        return String(format: idx == 0 ? "%.0f %@" : "%.1f %@", value, units[idx])
+    }
+}
+
+#endif
diff -ruN a/Compat/UIKitShims+tvOS.swift b/Compat/UIKitShims+tvOS.swift
--- a/Compat/UIKitShims+tvOS.swift	1970-01-01 09:00:00.000000000 +0900
+++ b/Compat/UIKitShims+tvOS.swift	2026-10-11 16:37:28.183500182 +0900
@@ -0,0 +1,113 @@
+//
+//  UIKitShims+tvOS.swift
+//  MeloNX (tvOS)
+//
+//  tvOS UIKit에 없는 심볼을 앱 모듈에 최소 형태로 되살린다.
+//  목적은 호출부를 고치지 않는 것이다 — 화면 회전과 대체 아이콘은
+//  Apple TV에서 의미가 없으므로 전부 무해한 고정값/무동작으로 둔다.
+//
+//  여기 선언한 타입은 모두 UIKit이 tvOS에서 `unavailable`로 표시한 것들이라
+//  이름 충돌이 생기지 않는다. 앱 모듈 쪽이 먼저 해석된다.
+//
+//  대응 범위
+//   · UIDeviceOrientation / UIInterfaceOrientation / UIInterfaceOrientationMask
+//   · UIDevice.orientation
+//   · ProcessInfo.isiOSAppOnMac            (16곳에서 사용)
+//   · UIApplication 대체 아이콘 API         (AppIconSwitcher 4곳)
+//   · OrientationManager                   (InGameConfigView 2곳)
+//
+
+#if os(tvOS)
+
+import UIKit
+
+// MARK: - 방향 타입
+
+/// Apple TV는 회전하지 않는다. 항상 landscapeLeft로 고정한 값만 돌려준다.
+enum UIDeviceOrientation: Int {
+    case unknown = 0
+    case portrait = 1
+    case portraitUpsideDown = 2
+    case landscapeLeft = 3
+    case landscapeRight = 4
+    case faceUp = 5
+    case faceDown = 6
+
+    /// BaseController+Motion.swift 가 쓰는 프로퍼티.
+    var isValidInterfaceOrientation: Bool {
+        switch self {
+        case .portrait, .portraitUpsideDown, .landscapeLeft, .landscapeRight: return true
+        case .unknown, .faceUp, .faceDown: return false
+        }
+    }
+
+    var isLandscape: Bool { self == .landscapeLeft || self == .landscapeRight }
+    var isPortrait: Bool { self == .portrait || self == .portraitUpsideDown }
+}
+
+enum UIInterfaceOrientation: Int {
+    case unknown = 0
+    case portrait = 1
+    case portraitUpsideDown = 2
+    case landscapeLeft = 4
+    case landscapeRight = 3
+}
+
+struct UIInterfaceOrientationMask: OptionSet {
+    let rawValue: UInt
+    init(rawValue: UInt) { self.rawValue = rawValue }
+
+    static let portrait             = UIInterfaceOrientationMask(rawValue: 1 << 1)
+    static let landscapeLeft        = UIInterfaceOrientationMask(rawValue: 1 << 4)
+    static let landscapeRight       = UIInterfaceOrientationMask(rawValue: 1 << 3)
+    static let portraitUpsideDown   = UIInterfaceOrientationMask(rawValue: 1 << 2)
+    static let landscape: UIInterfaceOrientationMask = [.landscapeLeft, .landscapeRight]
+    static let all: UIInterfaceOrientationMask =
+        [.portrait, .portraitUpsideDown, .landscapeLeft, .landscapeRight]
+    static let allButUpsideDown: UIInterfaceOrientationMask =
+        [.portrait, .landscapeLeft, .landscapeRight]
+}
+
+extension UIDevice {
+    /// tvOS에는 없다. 에뮬레이션 화면이 가로로 고정되므로 landscapeLeft로 답한다.
+    var orientation: UIDeviceOrientation { .landscapeLeft }
+}
+
+// MARK: - Mac 판별
+
+extension ProcessInfo {
+    /// tvOS에는 없는 프로퍼티. Apple TV는 Mac이 아니다.
+    var isiOSAppOnMac: Bool { false }
+}
+
+// MARK: - 대체 앱 아이콘
+
+extension UIApplication {
+    /// tvOS는 대체 아이콘을 지원하지 않는다. 설정 화면이 그대로 뜨되
+    /// 아무 일도 일어나지 않게 한다 (에러도 내지 않는다).
+    var supportsAlternateIcons: Bool { false }
+
+    var alternateIconName: String? { nil }
+
+    func setAlternateIconName(_ alternateIconName: String?,
+                              completionHandler: ((Error?) -> Void)? = nil) {
+        completionHandler?(nil)
+    }
+}
+
+// MARK: - 방향 고정 (무동작)
+
+/// Common/OrientationManager.swift 는 tvOS에서 컴파일되지 않는다
+/// (UINavigationController.attemptRotationToDeviceOrientation 가 없음).
+/// 같은 이름·시그니처의 무동작 구현으로 호출부를 그대로 둔다.
+enum OrientationManager {
+    static func lockOrientation(_ orientation: UIInterfaceOrientationMask,
+                                rotateTo rotateOrientation: UIInterfaceOrientation) {}
+
+    static func lockOrientation(_ orientation: UIInterfaceOrientationMask,
+                                rotateTo rotateOrientation: UIDeviceOrientation) {}
+
+    static func lockCurrentOrientation(_ orientation: UIDeviceOrientation) {}
+}
+
+#endif
