diff -ruN a/Compat/FileImporter+tvOS.swift b/Compat/FileImporter+tvOS.swift
--- a/Compat/FileImporter+tvOS.swift	1970-01-01 09:00:00.000000000 +0900
+++ b/Compat/FileImporter+tvOS.swift	2026-10-11 16:37:28.183397728 +0900
@@ -0,0 +1,115 @@
+//
+//  FileImporter+tvOS.swift
+//  MeloNX (tvOS)
+//
+//  Common/FileImporter.swift 의 FileImporterManager 와 **같은 공개 API**를 가진
+//  tvOS 구현. 호출부 9곳(KeysView, FirmwareView, GamesListView+ToolBar,
+//  SettingsView 등)은 한 줄도 고치지 않는다.
+//
+//  iOS: UIDocumentPickerViewController
+//  tvOS: TVFileBrowser (직접 파일시스템 순회)
+//
+//  Common/FileImporter.swift 의 extension(importSingleFile / importMultipleFiles /
+//  importImages / importDocuments)은 플랫폼 중립이라 그대로 재사용된다.
+//
+
+#if os(tvOS)
+
+import SwiftUI
+import UIKit
+import UniformTypeIdentifiers
+
+final class FileImporterManager: NSObject, ObservableObject {
+
+    static let shared = FileImporterManager()
+
+    private var presented: UIViewController?
+
+    /// iOS 구현과 시그니처가 동일하다. securityScoped 는 tvOS에서 의미가 없어
+    /// 받기만 하고 무시한다 (TrollStore 설치본은 샌드박스 밖을 직접 읽는다).
+    func importFiles(
+        types: [UTType],
+        allowMultiple: Bool = false,
+        securityScoped: Bool = true,
+        completion: @escaping (Result<[URL], Error>) -> Void
+    ) {
+        DispatchQueue.main.async {
+            guard let host = Self.topViewController() else {
+                completion(.failure(FileImportError.noPresenter))
+                return
+            }
+            guard self.presented == nil else {
+                completion(.failure(FileImportError.alreadyPresenting))
+                return
+            }
+
+            let browser = TVFileBrowser(
+                allowedTypes: types,
+                allowMultiple: allowMultiple
+            ) { [weak self] urls in
+                self?.dismiss()
+                if urls.isEmpty {
+                    completion(.failure(FileImportError.cancelled))
+                } else {
+                    completion(.success(urls))
+                }
+            }
+
+            let controller = UIHostingController(rootView: browser)
+            controller.modalPresentationStyle = .fullScreen
+            self.presented = controller
+            host.present(controller, animated: true)
+        }
+    }
+
+    private func dismiss() {
+        presented?.dismiss(animated: true)
+        presented = nil
+    }
+
+    // MARK: 최상위 뷰컨트롤러
+
+    private static func topViewController() -> UIViewController? {
+        let scenes = UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }
+        let window = scenes
+            .first(where: { $0.activationState == .foregroundActive })?
+            .windows.first(where: \.isKeyWindow)
+            ?? scenes.flatMap(\.windows).first(where: \.isKeyWindow)
+            ?? scenes.flatMap(\.windows).first
+
+        guard let root = window?.rootViewController else { return nil }
+        return topMost(of: root)
+    }
+
+    private static func topMost(of controller: UIViewController) -> UIViewController {
+        if let presented = controller.presentedViewController {
+            return topMost(of: presented)
+        }
+        if let nav = controller as? UINavigationController,
+           let visible = nav.visibleViewController {
+            return topMost(of: visible)
+        }
+        if let tab = controller as? UITabBarController,
+           let selected = tab.selectedViewController {
+            return topMost(of: selected)
+        }
+        return controller
+    }
+}
+
+enum FileImportError: LocalizedError {
+    case cancelled
+    case noPresenter
+    case alreadyPresenting
+
+    var errorDescription: String? {
+        switch self {
+        case .cancelled:        return "선택이 취소되었습니다."
+        case .noPresenter:      return "파일 선택 화면을 띄울 창을 찾지 못했습니다."
+        case .alreadyPresenting:return "파일 선택 화면이 이미 열려 있습니다."
+        }
+    }
+}
+
+#endif
