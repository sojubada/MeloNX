<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Only needed when using pre-release versions of Ryujinx.LibHac. -->
        <add key="LibHacAlpha" value="https://starforgejo.dev/api/packages/Ryulynx/nuget/index.json" />
    </packageSources>
    <packageSourceMapping>
        <!-- key value for <packageSource> should match key values from <packageSources> element -->
        <!-- These are defined and .NET still yells about multiple package sources with no mappings. Not sure what to do, this is in the docs lol -->
        <packageSource key="nuget.org">
            <package pattern="*" />
            <!-- 명시 패턴이 필요하다. PackageSourceMapping 은 최장 일치가
                 이기므로, LibHacAlpha 쪽의 "Ryujinx.LibHac" 패턴이
                 여기 "*" 보다 우선한다. 같은 패턴을 여기에도 적어
                 두 소스를 모두 후보로 만든다. -->
            <package pattern="Ryujinx.LibHac" />
        </packageSource>
        <packageSource key="LibHacAlpha">
            <package pattern="Ryujinx.LibHac" />
        </packageSource>
    </packageSourceMapping>
</configuration>
